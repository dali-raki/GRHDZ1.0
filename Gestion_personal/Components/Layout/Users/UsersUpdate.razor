@using Implementation.Services.Users
@if (isUpdateModalVisible)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modifier Utilisateur</h5>
                    <button type="button" class="btn-close" @onclick="CloseUpdateModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Nom d'utilisateur</label>
                        <input class="form-control" @bind="selectedUser.Username" />
                    </div>
                    <div class="mb-3">
                        <label>Rôle</label>
                        <input class="form-control" @bind="selectedUser.Role" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="UpdateUser">Enregistrer</button>
                    <button class="btn btn-secondary" @onclick="CloseUpdateModal">Annuler</button>
                </div>
            </div>
        </div>
    </div>
}


