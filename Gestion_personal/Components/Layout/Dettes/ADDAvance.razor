@using GrhDz.Domains.Models.Employees


@if (IsVisibleADDAvance)
{
    <div class="modal" tabindex="-1" style="display: block;">
        <div class="modal-dialog w-50">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajouter AvanceModel</h5>
                </div>

                <div class="modal-body">
                    <form @onsubmit="HandleSubmit">
                        <div class="form-group">
                            <label>Employes</label>
                            <RadzenDropDownDataGrid Data="@listememployes"
                                                    @bind-Value="selectedEmployeId"
                                                    TextProperty="FullName"
                                                    ValueProperty="EmployeID"
                                                    Placeholder="-- Choisir Employe --"
                                                    AllowFiltering="true"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    Style="width: 100%;"
                                                    Required="true">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Property="Nom" Title="Nom" />
                                    <RadzenDropDownDataGridColumn Property="Prenom" Title="Prenom" />
                                    <RadzenDropDownDataGridColumn Property="FonctionName" Title="Fonction" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </div>
                        <div class="form-group">
                            <label>Valeur de AvanceModel</label>
                            <input type="number" class="form-control" @bind="avanceMontant" placeholder="00000.00DA" step="0.01" min="500" required/>
                            <div class="modal-footer">
                                <button type="button" @onclick="@Hide_Popup_AddAvance" class="btn-c">Annuler</button>
                                <button type="submit " class="btn-p">Confirme</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}