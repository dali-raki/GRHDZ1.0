@using Implementation.Services.LogsActions
@using Infrastructures.Storages.LogActionStorage

@if (IsVisibleConfirm)
{

    <div class="modal" tabindex="-1" style="display: block;">
  <div class="modal-dialog" role="document">
    <div class="modal-content d-flex align-items-center">
                <div class="modal-header" style="text-align:end;width:100%;margin-bottom: 20px;">
         <h5 class="modal-title">@Title</h5>
         </div>
         <div class="mb-5">
                    <h5>Êtes-vous sûr de vouloir supprimer cet utilisateur ?</h5>
         </div>
            <div class="modal-footer" style="width:100%;">
                <div class="modal-body" style="width:300px">
                    <div class="d-flex justify-content-evenly gap-2">
                        <button class="btn-c" @onclick="close">No</button>
                        <button class="btn-d" @onclick="confirm">Yes</button>
                   
                    </div>
                </div>
                </div>

                    </div>
                </div>
            </div>
       
 
}




